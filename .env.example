# Copy to .env and fill in. .env is gitignored.

# --- Azure OpenAI ---
AZURE_ENDPOINT=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Anthropic ---
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=

# --- Google ---
GOOGLE_API_KEY=

# --- Per-purpose model overrides (provider.model) ---
MODELS_EMBEDDING=azure.text-embedding-3-small
MODELS_DEFAULT=claude.sonnet-4.6
MODELS_GATHER_INFO=azure.gpt-4.1-mini
MODELS_PLATFORM_INTERNALS=azure.gpt-5.2
MODELS_REVERSE_ENGINEERING=azure.gpt-5.2
MODELS_RESEARCHER=azure.gpt-5.2

# --- Thresholds (see src/patchdiff_ai/config/thresholds.py) ---
# Relevancy cut-off for candidate executables sent to RE (0.0 - 10.0).
# Strict `>` -- a candidate scoring exactly this value is dropped.
#THRESHOLDS__CANDIDATES=7.5
# Relevancy cut-off for picking which decompiled diffs to analyse (0.0 - 1.0).
#THRESHOLDS__SECURITY_MODIFICATION=0.25
# Confidence cut-off for accepting a generated report (0.0 - 1.0).
#THRESHOLDS__REPORT=0.1
